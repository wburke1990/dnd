#!/usr/bin/env bash
# Pre-commit hook for the dnd campaign repo.
#
# Runs code quality checks (ruff lint, ruff format, mypy strict, pytest,
# typos, luacheck on TTS Lua) and security/compliance scans (gitleaks for
# secrets, pip-audit for CVEs, pip-licenses for license allowlist, and
# linting this hook with shellcheck). Stays silent when everything passes
# so it doesn't bloat automated commit transcripts; prints captured output
# for any check that fails.
#
# Security checks fail closed. gitleaks is REQUIRED: if it isn't on PATH the
# commit aborts, because a scanner that never ran is indistinguishable from a
# scanner that passed, and this repo commits mostly from automated flows where
# nobody is watching the terminal. (It was missing on the owner's Mac for
# months, silently, and every commit from that machine went unscanned.)
# pip-audit still tolerates an unreachable pypi.org — that's transient, not a
# misconfiguration — but says so unconditionally instead of only on a TTY.
#
# The quality tools (shellcheck, luacheck) stay optional and quiet: they lint,
# they don't guard.
#
# Silence on success is deliberate and preserved — these hooks run in agent
# transcripts, so a passing commit must stay clean. Loud means broken.
#
# Install: `git config core.hooksPath .githooks` (run once per clone).

set -u

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPTS_DIR="$REPO_ROOT/scripts"

# Allowlist of acceptable dependency licenses. pip-licenses matches strings
# exactly, so include each variant the ecosystem emits (SPDX id vs classifier
# string). Add entries deliberately after reviewing the actual license text.
ALLOWED_LICENSES="MIT;MIT License;MIT-CMU;HPND;BSD;BSD License;BSD-2-Clause;BSD-3-Clause;Apache-2.0;Apache 2.0;Apache Software License;Apache-2.0 OR BSD-2-Clause;Mozilla Public License 2.0 (MPL 2.0);MPL-2.0;Python Software Foundation License;PSF-2.0;ISC License (ISCL);ISC"

# Run a check, capturing both streams. On success, swallow output. On failure,
# print a header and the captured output so the user sees what broke.
run_check() {
    local name="$1"
    shift
    local output
    local rc

    output="$("$@" 2>&1)"
    rc=$?

    if [[ $rc -ne 0 ]]; then
        printf '\n=== pre-commit: %s FAILED ===\n%s\n' "$name" "$output" >&2
    fi

    return $rc
}

# Print a one-line skip notice — only when stderr is a TTY, so automated
# flows (Claude, CI) stay silent. Interactive users see install hints.
skip_notice() {
    if [[ -t 2 ]]; then
        printf 'pre-commit: %s skipped — %s\n' "$1" "$2" >&2
    fi
}

failures=0

# --- Code quality -----------------------------------------------------------

run_check "ruff check" \
    uv --directory "$SCRIPTS_DIR" run --quiet ruff check . \
    || failures=$((failures + 1))

run_check "ruff format" \
    uv --directory "$SCRIPTS_DIR" run --quiet ruff format --check . \
    || failures=$((failures + 1))

run_check "mypy --strict" \
    uv --directory "$SCRIPTS_DIR" run --quiet mypy . \
    || failures=$((failures + 1))

run_check "pytest" \
    uv --directory "$SCRIPTS_DIR" run --quiet pytest -q \
    || failures=$((failures + 1))

run_check "typos" \
    uv --directory "$SCRIPTS_DIR" run --quiet typos "$REPO_ROOT" \
    || failures=$((failures + 1))

# --- Prose style (advisory — never blocks) ---------------------------------
# Flags house-style issues on staged content-markdown lines (see CLAUDE.md).
# Report-only: it prints findings but never aborts the commit, because the
# back-catalog still has plenty and a false positive shouldn't stop a commit.
prose_out="$(uv --directory "$SCRIPTS_DIR" run --quiet prose-lint --staged 2>/dev/null)"
if [[ -n "$prose_out" && "$prose_out" != "clean"* ]]; then
    printf '\n=== pre-commit: prose-lint (advisory, not blocking) ===\n%s\n' "$prose_out" >&2
fi

# --- Lua linting on TTS scripts --------------------------------------------

# Scoped to *staged* Lua only. Linting the whole tree meant a commit touching
# nothing but markdown could be aborted by tens of thousands of pre-existing
# warnings in extracted per-object fragments nobody had edited — which is what
# happens in containers, where luacheck is present. You are responsible for the
# Lua you are committing, not for the back catalogue.
if command -v luacheck >/dev/null 2>&1; then
    staged_lua=()
    while IFS= read -r f; do
        [[ "$f" == *.lua ]] && staged_lua+=("$REPO_ROOT/$f")
    done < <(git -C "$REPO_ROOT" diff --cached --name-only --diff-filter=ACM -- tts/lua)

    if (( ${#staged_lua[@]} > 0 )); then
        run_check "luacheck (staged tts/lua)" \
            luacheck "${staged_lua[@]}" --config "$REPO_ROOT/.luacheckrc" --no-color \
            || failures=$((failures + 1))
    fi
else
    skip_notice "luacheck" "binary not on PATH (brew install luarocks && luarocks install luacheck)"
fi

# --- Security & compliance --------------------------------------------------

# Secret scanning on staged content only — fast, no network. Required: absence
# aborts the commit rather than passing quietly.
if command -v gitleaks >/dev/null 2>&1; then
    run_check "gitleaks (secrets)" \
        gitleaks git --staged --no-banner --redact "$REPO_ROOT" \
        || failures=$((failures + 1))
else
    printf '\n=== pre-commit: gitleaks MISSING ===\n%s\n' \
        'Secret scanning cannot run, so this commit is unscanned and is being refused.
Install it: brew install gitleaks  (or apt / https://github.com/gitleaks/gitleaks)' >&2
    failures=$((failures + 1))
fi

# The lockfile is what makes every other guarantee here hold: it pins all 50
# packages by sha256, and pip-audit scans the environment built from it. A
# dependency added to pyproject.toml without relocking would be unpinned and
# unscanned, so fail when the two have drifted apart.
run_check "uv lock --check (lockfile current)" \
    uv --directory "$SCRIPTS_DIR" lock --check \
    || failures=$((failures + 1))

# Dependency CVE scan against the PyPI advisory database. Skip on network
# failure so commits aren't blocked when offline.
if curl -sfI --max-time 4 https://pypi.org/simple/ >/dev/null 2>&1; then
    run_check "pip-audit (CVEs)" \
        uv --directory "$SCRIPTS_DIR" run --quiet pip-audit --progress-spinner off \
        || failures=$((failures + 1))
else
    # Unconditional, not TTY-gated: an unscanned commit must never look like a
    # clean one. Non-blocking, because unreachable pypi.org is transient and
    # the dependency set is hash-pinned in uv.lock between changes.
    printf '\n=== pre-commit: pip-audit SKIPPED ===\n%s\n' \
        'pypi.org unreachable — dependencies were NOT scanned for CVEs on this commit.' >&2
fi

# License compliance — fails if any installed dependency declares a license
# outside ALLOWED_LICENSES. Local and fast.
run_check "pip-licenses (allowlist)" \
    uv --directory "$SCRIPTS_DIR" run --quiet pip-licenses \
        --allow-only="$ALLOWED_LICENSES" \
        --format=plain \
    || failures=$((failures + 1))

# Lint the hooks themselves so we catch bugs in this file.
# Covers .claude/hooks too, not just this directory. session-start.sh downloads
# a binary and installs it to /usr/local/bin as root, which makes it the most
# privileged script in the repo and, until now, the only unlinted one.
# Required, like gitleaks: it is installed on every machine that commits here.
if command -v shellcheck >/dev/null 2>&1; then
    hook_files=()
    for f in "$REPO_ROOT"/.githooks/* "$REPO_ROOT"/.claude/hooks/*.sh; do
        [[ -f "$f" ]] && hook_files+=("$f")
    done
    if (( ${#hook_files[@]} > 0 )); then
        run_check "shellcheck (hooks)" \
            shellcheck "${hook_files[@]}" \
            || failures=$((failures + 1))
    fi
else
    printf '\n=== pre-commit: shellcheck MISSING ===\n%s\n' \
        'The hook scripts cannot be linted, including the one that installs binaries as root.
Install it: brew install shellcheck  (or apt-get install shellcheck)' >&2
    failures=$((failures + 1))
fi

if [[ $failures -gt 0 ]]; then
    printf '\npre-commit: %d check(s) failed; commit aborted.\n' "$failures" >&2
    exit 1
fi

exit 0
